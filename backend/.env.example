SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql://username:password@localhost:5432/riffs
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
# Same OAuth Client ID as the frontend's VITE_GOOGLE_CLIENT_ID — used to
# verify the ID token Google sends back after a user signs in.
GOOGLE_CLIENT_ID=
# How many days out a saved event counts as an "upcoming" notification.
NOTIFICATION_WINDOW_DAYS=14
